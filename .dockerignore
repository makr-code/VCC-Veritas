# Docker Build Ignore Rules
# This file prevents unnecessary files from being sent to the Docker build context
# Reducing build context size improves build performance

# ========================================
# Version Control & Git
# ========================================
.git/
.gitignore
.gitattributes
.github/

# ========================================
# Documentation & Markdown
# ========================================
*.md
docs/
CONTRIBUTING.md
README.md
DEVELOPMENT.md

# ========================================
# IDEs & Editors
# ========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ========================================
# OS Specific Files
# ========================================
.DS_Store
Thumbs.db
desktop.ini
.Thumbs.db

# ========================================
# Python Development
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ========================================
# Node / Frontend (if present)
# ========================================
node_modules/
npm-debug.log
yarn-error.log

# ========================================
# Local Development Files
# ========================================
.env
.env.*
.env.local
.env.*.local
docker-compose.override.yml
docker-compose.debug.yml

# ========================================
# Test & Coverage Reports
# ========================================
.coverage
coverage.xml
htmlcov/
.pytest_cache/
pytest-debug.log
bandit_report.json
bandit_rescan.txt

# ========================================
# Build Artifacts
# ========================================
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# ========================================
# Database Files (Local Development)
# ========================================
*.db
*.sqlite
*.sqlite3

# ========================================
# Cache & Temporary
# ========================================
.cache/
tmp/
temp/

# ========================================
# CI/CD & Monitoring
# ========================================
.github/
.gitlab-ci.yml
azure-pipelines.yml
Jenkins*

# ========================================
# Backup & Archive
# ========================================
*.tar
*.tar.gz
*.zip
*.rar
backups/
*.backup
